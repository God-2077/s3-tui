# 必填：桶名与凭证
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# 可选：临时凭证 token
# S3_SESSION_TOKEN=

# 区域；Cloudflare R2 填 auto
S3_REGION=us-east-1

# S3 兼容端点；连 AWS 时留空
# R2:   https://<account-id>.r2.cloudflarestorage.com
# MinIO: http://192.168.1.10:9000
# S3_ENDPOINT=

# 有自定义端点时默认 true；MinIO/R2 一般需要 true
# S3_FORCE_PATH_STYLE=true

# 启动时进入的目录
# S3_INITIAL_PREFIX=photos/

# 加速主机：只写域名（省略协议时按 https）
# 默认模式下该域根路径直接对应桶，例如：
# S3_ACCELERATE_HOST=my-bucket.s3-accelerate.amazonaws.com
# endpoint = 用加速域重新签名并传输
# rewrite  = 主端点签名后替换 host（纯 CDN，签名需被放行）
# public   = 只生成无签名公开直链（桶需开启公开访问），传输仍走主端点
# S3_ACCELERATE_MODE=endpoint
# 加速域是 host/bucket/key 形态时设为 true
# S3_ACCELERATE_PATH_STYLE=false

# 传输参数
# 单个上传文件的分片并发 / 目录移动并发
S3_CONCURRENCY=4
# 同时上传、下载的文件数
S3_UPLOAD_CONCURRENCY=2
S3_DOWNLOAD_CONCURRENCY=2
# 单个下载文件的分段线程数与分段大小（MiB）
S3_DOWNLOAD_THREADS=4
S3_DOWNLOAD_PART_SIZE_MB=8
S3_PART_SIZE_MB=8
S3_MULTIPART_THRESHOLD_MB=8
# S3_DOWNLOAD_DIR=./downloads
# S3_PRESIGN_EXPIRES=3600

# 显示桶总大小与文件夹递归大小（会额外列举对象，桶很大时较慢）
# S3_SHOW_SIZES=false

# 调试日志
# S3_TUI_DEBUG=false
# S3_TUI_LOG=./s3-tui.log