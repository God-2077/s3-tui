{
  "name": "s3-tui",
  "version": "0.1.0",
  "description": "Terminal UI for browsing and managing S3-compatible object storage",
  "type": "module",
  "bin": {
    "s3-tui": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/format.test.ts test/key.test.ts test/manage.test.ts test/multipart.test.ts test/config.test.ts test/url.test.ts test/input.test.ts test/s3.integration.test.ts test/accelerate.test.ts"
  },
  "keywords": [
    "s3",
    "tui",
    "ink",
    "terminal",
    "minio",
    "r2"
  ],
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "ink": "^8.0.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.0.9",
      "onFail": "download"
    }
  }
}